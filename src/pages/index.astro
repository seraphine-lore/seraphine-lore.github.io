---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages } from '../data/research';
const root = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (part: string) => `${root}${part.replace(/^\//, '')}`;
---
<SiteLayout
  pageType="home"
  title="Seraphine Lore Misinformation: Influencer Cherry-Picking, Google AI and Wikipedia | HUNTtheTRUTH"
  description="Riot’s official League site published Seraphine’s empathy and Brackern lore before the backlash. See what major YouTubers omitted, and how Google AI and Wikipedia represented the story."
>
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-lines" aria-hidden="true"></div>
    <div class="container hero-content">
      <p class="eyebrow hero-eyebrow"><span class="diamond">◆</span> AN INDEPENDENT INVESTIGATION <span class="diamond">◆</span></p>
      <p class="hero-overline">THE TRUTH IS NEVER WHAT IT SEEMS</p>
      <h1><em>Seraphine Lore</em><span>MISINFORMATION INVESTIGATION</span></h1>
      <div class="hero-rule"><span>✧</span></div>
      <p class="hero-deck">Riot published Seraphine’s empathy and Brackern lore on the official League of Legends website before the backlash.<br /><strong>Influential YouTubers omitted its crucial explanations. Google Search and AI later surfaced secondary claims — while even Wikipedia.org went six years without citing Riot’s original article.</strong></p>
      <div class="hero-actions">
        <a class="cta" href={href('seraphine-lore-misinformation-investigation/')}>READ THE FULL MISINFORMATION INVESTIGATION <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={href('sources/')}>EXAMINE THE SOURCES</a>
      </div>
    </div>
    <div class="hero-bottom" aria-hidden="true"><span>EXPLORE THE EVIDENCE</span><span>↓</span></div>
  </section>

  <section class="premise section-space">
    <div class="container narrow centre">
      <p class="eyebrow">THE INVESTIGATION</p>
      <h2>Published on Riot’s <em>official website.</em><br />Omitted from the <em>influencer narrative.</em></h2>
      <p class="large-copy">On <strong>12 October 2020</strong>, Riot published <a href="https://www.leagueoflegends.com/en-us/news/dev/champion-insights-seraphine/"><em>Champion Insights: Seraphine</em></a> on the <strong>official League of Legends website</strong>. Riot established Seraphine’s deep empathy, identified Skarner’s family among the Brackern souls in Hextech crystals, and explicitly stated that being unable to rescue those souls did <strong>not</strong> mean indifference. Those explanations were omitted from the key influencer accusations examined here.</p>
      <p>Skooch omitted Riot’s official article from his K/DA comparison. NickyBoi used artwork originating in it but excluded its narrative context. T B Skyen’s and Necrit’s lore accusations did not account for its explanations. ProGuides cited design material from the same article but omitted its Brackern rescue explanation. The investigation traces influencer cross-references, Google Search and AI citations, and <strong>Wikipedia.org’s six-year failure to cite Riot’s official source</strong>.</p>
    </div>
  </section>

  <section class="evidence-section section-space" id="four-layers">
    <div class="container">
      <div class="section-heading centre"><p class="eyebrow">THE EVIDENCE</p><h2>Four parts of the evidence trail</h2><span class="ornament">◆</span></div>
      <div class="pillars">
        <article class="pillar"><span class="pillar-number">I</span><div class="pillar-line"></div><h3>OFFICIAL RIOT SOURCE</h3><p>Published on the League website on 12 October 2020, before the influencer videos.</p><span class="pillar-meta">12 OCTOBER 2020</span></article>
        <article class="pillar"><span class="pillar-number">II</span><div class="pillar-line"></div><h3>EXECUTION</h3><p>The disputed Skarner voice line, six biography revisions and Riot’s corrections.</p><span class="pillar-meta">OCTOBER 2020</span></article>
        <article class="pillar"><span class="pillar-number">III</span><div class="pillar-line"></div><h3>INFLUENCER OMISSIONS</h3><p>Which influencers omitted Riot’s published explanations and contradicted their own sources.</p><span class="pillar-meta">INFLUENCER COVERAGE</span></article>
        <article class="pillar"><span class="pillar-number">IV</span><div class="pillar-line"></div><h3>PROPAGATION</h3><p>Influencer cross-references, Google and AI source cards — and Wikipedia’s six-year Riot citation gap.</p><span class="pillar-meta">2020–2026</span></article>
      </div>
    </div>
  </section>

  <section class="feature section-space">
    <div class="container feature-grid">
      <div class="feature-panel">
        <span class="feature-visual-kicker">PRIMARY SOURCE / 12 OCTOBER 2020</span>
        <div class="feature-sigil" aria-hidden="true">✧<span>◈</span>✧</div>
        <span class="feature-visual-footer">OFFICIAL LEAGUE OF LEGENDS WEBSITE · 12 OCTOBER 2020</span>
      </div>
      <div class="feature-content">
        <p class="eyebrow">CHAMPION INSIGHTS: SERAPHINE</p>
        <h2>Riot published it.<br /><em>The videos omitted its explanation.</em></h2>
        <p><em>Champion Insights: Seraphine</em> was <strong>published on Riot’s official League of Legends website on 12 October 2020</strong>, not hidden in an obscure archive. Yet Skooch’s 16 October comparison omitted the article; NickyBoi’s 24 October video used artwork originating in it while omitting its explanation of empathy and Brackern suffering; and T B Skyen’s and Necrit’s lore accusations failed to address that material. <strong>Even ProGuides, which cited the article for design details, omitted its explicit explanation that Seraphine’s inability to save trapped Brackern souls did not mean she did not care.</strong></p>
        <a class="underlined-link" href="https://www.leagueoflegends.com/en-us/news/dev/champion-insights-seraphine/">READ THE OFFICIAL RIOT ARTICLE THE VIDEOS OMITTED <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section-space chapters" id="chapters">
    <div class="container">
      <div class="section-heading centre"><p class="eyebrow">EXAMINE THE CLAIMS</p><h2>The influencer accusations. Riot’s omitted evidence. Wikipedia’s six-year gap.</h2><span class="ornament">◆</span></div>
      <div class="chapter-grid">
        {pages.map((page, index) => (
          <a class="chapter" href={href(`${page.slug}/`)}>
            <span class="chapter-number">{String(index + 1).padStart(2, '0')} / {page.eyebrow}</span>
            <h3>{page.title}</h3>
            <p set:html={page.lead} />
            <span class="chapter-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
